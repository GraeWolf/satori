# Base system. Kept on installed systems.
sysvinit-core
sudo

# Provides systemd-sysusers without systemd code. Without it, apt satisfies
# dependencies such as cron-daemon-common's with Debian's
# systemd-standalone-sysusers (DEC-010).
opensysusers

# Third-party repositories, keys and pins (DEC-026). The desktop itself is
# installed by config/hooks/normal/0500-satori-desktop.hook.chroot.
satori-apt-sources
