#!/bin/sh
# Live session only: log the live user in automatically on tty1-6, which then
# starts the desktop on tty1 (/etc/profile.d/satori-startx.sh).
#
# Replaces live-config's own 0160-sysvinit component, which never works on
# Excalibur for two reasons:
#   1. It checks for a package named "sysvinit", which no longer exists (it's
#      sysvinit-core), so it always exits early.
#   2. Its inittab line runs "/bin/login -f" through "sh -c" instead of a
#      getty, so tty1 never becomes login's controlling terminal and login is
#      stopped by job control before it can log in.
# This uses agetty's --autologin instead, which sets the terminal up properly.

. /lib/live/config.sh

Cmdline ()
{
	for _PARAMETER in ${LIVE_CONFIG_CMDLINE}
	do
		case "${_PARAMETER}" in
			live-config.noautologin|noautologin|live-config.nottyautologin|nottyautologin)
				exit 0
				;;
			live-config.username=*|username=*)
				LIVE_USERNAME="${_PARAMETER#*username=}"
				;;
		esac
	done
}

Init ()
{
	if ! pkg_is_installed "sysvinit-core" || component_was_executed "satori-autologin"
	then
		exit 0
	fi
	echo -n " satori-autologin"
}

Config ()
{
	# Only the tty1-tty6 getty lines; the serial test getty (T0) is left alone.
	sed -i -e "/^[^:]*:[^:]*:[^:]*:\/sbin\/getty .*\<tty[0-9][0-9]*[[:space:]]*$/s|/sbin/getty |/sbin/getty --autologin ${LIVE_USERNAME:-user} |" /etc/inittab
	init q
	touch /var/lib/live/config/satori-autologin
}

Cmdline
Init
Config
