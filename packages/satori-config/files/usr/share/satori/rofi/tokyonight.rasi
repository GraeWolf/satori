/* satori's rofi theme: Tokyo Night (night). Selected by /etc/rofi.rasi. */
* {
    bg:        #1a1b26;
    bg-alt:    #292e42;
    fg:        #c0caf5;
    fg-dim:    #565f89;
    accent:    #7aa2f7;
    active:    #7dcfff;
    urgent:    #f7768e;

    background-color: transparent;
    text-color:       @fg;
    font:             "JetBrains Mono 11";
}

window {
    width:            40%;
    padding:          12px;
    background-color: @bg;
    border:           2px;
    border-color:     @accent;
    border-radius:    6px;
}

mainbox {
    spacing: 8px;
}

inputbar {
    children:         [ prompt, entry ];
    spacing:          8px;
    padding:          6px 8px;
    background-color: @bg-alt;
    border-radius:    4px;
}

prompt {
    text-color: @accent;
}

entry {
    placeholder-color: @fg-dim;
}

listview {
    lines:        10;
    fixed-height: false;
    spacing:      2px;
    scrollbar:    false;
}

element {
    padding:       4px 8px;
    spacing:       8px;
    border-radius: 4px;
}

element normal.normal, element alternate.normal {
    text-color: @fg;
}

element selected.normal {
    background-color: @accent;
    text-color:       @bg;
}

element normal.active, element alternate.active {
    text-color: @active;
}

element selected.active {
    background-color: @active;
    text-color:       @bg;
}

element normal.urgent, element alternate.urgent {
    text-color: @urgent;
}

element selected.urgent {
    background-color: @urgent;
    text-color:       @bg;
}

element-icon, element-text {
    background-color: inherit;
    text-color:       inherit;
}

element-icon {
    size: 1.2em;
}

message {
    padding:          6px;
    background-color: @bg-alt;
    border-radius:    4px;
}
