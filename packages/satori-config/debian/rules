#!/usr/bin/make -f

%:
	dh $@

# The firewall init script is named satori-firewall, not satori-config.
override_dh_installinit:
	dh_installinit --name=satori-firewall

# Keep the helper scripts and autostart executable.
execute_after_dh_fixperms:
	chmod 0755 debian/satori-config/usr/bin/* \
		debian/satori-config/usr/share/satori/herbstluftwm/autostart
