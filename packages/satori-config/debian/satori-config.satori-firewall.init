#!/bin/sh
### BEGIN INIT INFO
# Provides:          satori-firewall
# Required-Start:    $local_fs
# Required-Stop:     $local_fs
# Should-Start:      nftables
# X-Start-Before:    $network
# Default-Start:     S
# Default-Stop:
# Short-Description: satori's default firewall
# Description:       Loads /etc/satori/nftables.conf (DEC-023): inbound traffic
#                    denied except loopback and replies, outbound allowed.
#                    Starts after nftables (if installed), whose own ruleset
#                    begins with "flush ruleset".
### END INIT INFO

RULES=/etc/satori/nftables.conf
NFT=/usr/sbin/nft

[ -x "${NFT}" ] || exit 0
. /lib/lsb/init-functions

case "$1" in
	start|restart|reload|force-reload)
		log_daemon_msg "Loading satori firewall" "satori-firewall"
		"${NFT}" -f "${RULES}"
		log_end_msg $?
		;;
	stop)
		log_daemon_msg "Removing satori firewall (all inbound traffic allowed)" "satori-firewall"
		"${NFT}" delete table inet satori 2>/dev/null
		log_end_msg 0
		;;
	status)
		# nft can't read the ruleset without root, which would look like
		# "not loaded". 4 is LSB's "status unknown".
		if [ "$(id -u)" -ne 0 ]; then
			echo "satori firewall status needs root: sudo service satori-firewall status" >&2
			exit 4
		fi
		if "${NFT}" list table inet satori >/dev/null 2>&1; then
			echo "satori firewall is loaded"
		else
			echo "satori firewall is NOT loaded"
			exit 3
		fi
		;;
	*)
		echo "Usage: $0 {start|stop|restart|reload|force-reload|status}" >&2
		exit 3
		;;
esac
exit 0
