#!/bin/sh
set -e

if [ "$1" = configure ]; then
	# Xsession starts x-session-manager; make satori-session the default.
	update-alternatives --install /usr/bin/x-session-manager x-session-manager \
		/usr/bin/satori-session 90
	# Add pam_gnome_keyring to console logins (DEC-030); see
	# /usr/share/pam-configs/satori-gnome-keyring.
	pam-auth-update --package
fi

#DEBHELPER#
