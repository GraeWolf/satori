#!/usr/bin/make -f

%:
	dh $@

# DEC-026: the build fails if a stored key doesn't match its recorded checksum.
override_dh_auto_build:
	cd keys && sha256sum --check --strict SHA256SUMS

# Brave's key goes where Brave's sources file expects it (see
# sources/brave-browser-release.sources and debian/preinst).
execute_after_dh_install:
	install -D -m 0644 keys/brave.gpg \
		debian/satori-apt-sources/usr/share/keyrings/brave-browser-archive-keyring.gpg
