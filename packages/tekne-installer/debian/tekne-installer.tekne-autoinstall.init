#!/bin/sh
### BEGIN INIT INFO
# Provides:          tekne-autoinstall
# Required-Start:    $all
# Required-Stop:
# Default-Start:     2 3 4 5
# Default-Stop:
# Short-Description: Unattended Tekne install for automated tests (QEMU only)
# Description:       Runs tekne-install unattended, then powers off, but only
#                    when BOTH hold: the live system was booted from the
#                    "serial console" GRUB entry (tekne.serial), and QEMU
#                    passed an answers file through fw_cfg as
#                    opt/tekne/answers. fw_cfg exists only in QEMU, so this
#                    can never erase a disk on real hardware.
### END INIT INFO

ANSWERS_FW=/sys/firmware/qemu_fw_cfg/by_name/opt/tekne/answers/raw
ANSWERS=/run/tekne-answers

case "$1" in
	start)
		grep -qw tekne.serial /proc/cmdline || exit 0
		modprobe qemu_fw_cfg 2>/dev/null || exit 0
		[ -r "${ANSWERS_FW}" ] || exit 0

		# Runs in the foreground, so gettys and the desktop don't start
		# until the install is done.
		(umask 077; cat "${ANSWERS_FW}" > "${ANSWERS}")
		echo "tekne-autoinstall: answers found, installing unattended" > /dev/console
		if tekne-install --answers "${ANSWERS}" > /dev/console 2>&1; then
			echo "TEKNE-INSTALL: SUCCESS" > /dev/console
		else
			echo "TEKNE-INSTALL: FAILED" > /dev/console
		fi
		rm -f "${ANSWERS}"
		poweroff
		;;
	stop|restart|force-reload|status)
		;;
	*)
		echo "Usage: $0 start" >&2
		exit 3
		;;
esac
exit 0
