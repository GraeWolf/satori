#!/usr/bin/make -f
# The artwork comes from the repository's branding/ directory (CC-BY-SA-4.0),
# which scripts/build-packages.sh copies in as branding/.

# os-release carries this build's version (DEC-032): 0.1~rc2~dev29.g80f8deb
# becomes VERSION 0.1-rc2-dev29.g80f8deb and VERSION_ID 0.1.
VERSION := $(shell dpkg-parsechangelog -S Version)
OS_VERSION := $(subst ~,-,$(VERSION))
OS_VERSION_ID := $(firstword $(subst ~, ,$(VERSION)))

%:
	dh $@

override_dh_auto_build:
	[ -f branding/wallpaper.svg ] || { echo "branding/ is missing: build with scripts/build.sh" >&2; exit 1; }
	mkdir -p build
	rsvg-convert -w 3840 -h 2160 -o build/tekne.png branding/wallpaper.svg
	rsvg-convert -w 1920 -h 1080 -o build/background.png branding/grub-background.svg
	rsvg-convert -w 256 -h 256 -o build/logo.png branding/logo.svg
	sed -e 's/@VERSION@/$(OS_VERSION)/g' -e 's/@VERSION_ID@/$(OS_VERSION_ID)/g' \
		files/os-release.in > build/os-release

override_dh_auto_clean:
	rm -rf build
