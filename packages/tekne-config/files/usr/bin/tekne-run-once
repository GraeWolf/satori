#!/bin/sh
# Start a program unless one with that process name is already running for
# this user. herbstluftwm re-runs its autostart on every reload, so everything
# it starts goes through this.
#   tekne-run-once NAME [COMMAND [ARGS...]]    (COMMAND defaults to NAME)
[ $# -ge 1 ] || { echo "usage: $0 NAME [COMMAND [ARGS...]]" >&2; exit 2; }
name="$1"
shift
[ $# -gt 0 ] || set -- "${name}"

if pgrep -u "$(id -u)" -x "${name}" >/dev/null 2>&1; then
	exit 0
fi
"$@" >/dev/null 2>&1 &
