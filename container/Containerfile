# satori build environment: Devuan Excalibur plus Debian's live-build (DEC-003).
# Built and run by scripts/build.sh; every external input is pinned.
FROM docker.io/devuan/devuan:excalibur@sha256:07b5f16e73ad7f81bd59b54e8901de8bf0a998be0c1df75a8d3e441f58b027aa

# Debian trixie's live-build. Devuan's own package is a 2016 fork without UEFI
# support. The SHA-1 is snapshot.debian.org's permanent address for the file.
ARG LIVE_BUILD_VERSION=20250505+deb13u1
ARG LIVE_BUILD_SHA256=58e09779881cbcc631c49ceb703413e0247a87db01823e597b2a1c40a2afd8f4
ARG LIVE_BUILD_SHA1=4dd9682896f13d1824d3819773791c3595076436

RUN apt-get update \
	&& DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
		apt-utils bzip2 ca-certificates cpio curl debhelper debootstrap dpkg-dev file rsync wget xz-utils \
	&& rm -rf /var/lib/apt/lists/*

RUN set -e; \
	deb="live-build_${LIVE_BUILD_VERSION}_all.deb"; \
	curl -fsSL -o "/tmp/${deb}" "https://deb.debian.org/debian/pool/main/l/live-build/${deb}" \
		|| curl -fsSL -o "/tmp/${deb}" "https://snapshot.debian.org/file/${LIVE_BUILD_SHA1}"; \
	echo "${LIVE_BUILD_SHA256}  /tmp/${deb}" | sha256sum -c -; \
	dpkg -i "/tmp/${deb}"; \
	rm "/tmp/${deb}"; \
	apt-mark hold live-build
